{
  "manifest_version": 3,
  "name": "APCG — Anti-Procrastination Commitment Grid",
  "version": "0.1.0",
  "description": "A private, local GitHub-style grid that turns your own Reels-watching habit into visible daily data — so you can see it instead of feel it.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "APCG — Your Grid"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
